# External PDF Generation API Configuration (POSTs { templateId, data } -> returns PDF)
PDF_API_URL=
PDF_API_KEY=
INVOICE_PDF_TEMPLATE_ID=tpl_invoice_pdf_v1
RECEIPT_PDF_TEMPLATE_ID=tpl_receipt_pdf_v1

# External Email Template Rendering API Configuration (POSTs { templateId, data } -> responds with HTML)
EMAIL_TEMPLATE_API_URL=
EMAIL_TEMPLATE_API_KEY=
RECEIPT_EMAIL_TEMPLATE_ID=tpl_order_receipt_email_v1

# Outbound SMTP Configuration for Nodemailer (sends rendered HTML email + Invoice & Receipt PDF attachments)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Storefront Orders <orders@storefront.example.com>"
