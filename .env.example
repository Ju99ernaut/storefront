# ComposeIt API Configuration (POSTs { templateId, formats: ["pdf"] | ["html"], data } with header `x-api-key`)
COMPOSEIT_API_URL=
COMPOSEIT_API_KEY=

INVOICE_PDF_TEMPLATE_ID=tpl_invoice_pdf_v1
RECEIPT_PDF_TEMPLATE_ID=tpl_receipt_pdf_v1
RECEIPT_EMAIL_TEMPLATE_ID=tpl_order_receipt_email_v1

# Outbound SMTP Configuration for Nodemailer (attaches PDFs via `path: pdf.url`)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Storefront Orders <orders@storefront.example.com>"
